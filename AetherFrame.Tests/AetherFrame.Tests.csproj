<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Pure-logic tests for AetherFrame, runnable without FFXIV or Dalamud.

    Rather than referencing the plugin project (which would pull Dalamud assemblies into the test
    process), this compiles the plugin's Dalamud-independent source files directly (linked, not
    copied). Everything listed here must stay free of Dalamud/ImGui dependencies; Dalamud glue
    lives elsewhere (Hosting/, UI/, Windows/, and the Dalamud-facing services).
  -->

  <!-- The plugin's product version, so the linked AetherFrameBuildInfo reads the same assembly
       metadata here as it does in the plugin. -->
  <Import Project="..\Version.props" />

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>AetherFrame.Tests</RootNamespace>
    <!-- The linked sources' XML docs reference Dalamud-side types that aren't compiled here. -->
    <NoWarn>$(NoWarn);CS1574;CS1584;CS1580;CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\AetherFrame\Domain\**\*.cs" Link="Linked\Domain\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\AetherFrame\Persistence\**\*.cs" Link="Linked\Persistence\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\AetherFrame\Services\Plates\**\*.cs" Link="Linked\Services\Plates\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\AetherFrame\Services\Templates\**\*.cs" Link="Linked\Services\Templates\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\AetherFrame\Services\Assets\**\*.cs" Link="Linked\Services\Assets\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\AetherFrame\Services\Caching\**\*.cs" Link="Linked\Services\Caching\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\AetherFrame\Services\Diagnostics\**\*.cs" Link="Linked\Services\Diagnostics\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\AetherFrame\Services\Thumbnails\**\*.cs" Link="Linked\Services\Thumbnails\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\AetherFrame\Services\Packages\**\*.cs" Link="Linked\Services\Packages\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\AetherFrame\Services\Commands\**\*.cs" Link="Linked\Services\Commands\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\AetherFrame\Services\Lifecycle\**\*.cs" Link="Linked\Services\Lifecycle\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\AetherFrame\Services\Art\**\*.cs" Link="Linked\Services\Art\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\AetherFrame\Services\AssetStorageService.cs" Link="Linked\Services\AssetStorageService.cs" />
    <Compile Include="..\AetherFrame\Services\ImageDimensionReader.cs" Link="Linked\Services\ImageDimensionReader.cs" />
    <Compile Include="..\AetherFrame\Services\ProfileService.cs" Link="Linked\Services\ProfileService.cs" />
    <Compile Include="..\AetherFrame\Services\CharacterInfoCache.cs" Link="Linked\Services\CharacterInfoCache.cs" />
    <Compile Include="..\AetherFrame\Services\EditorShortcutInterpreter.cs" Link="Linked\Services\EditorShortcutInterpreter.cs" />
    <!-- The font catalog is a static table with no Dalamud dependency; the font service that
         consumes it (and the atlas) stays out. -->
    <Compile Include="..\AetherFrame\Services\Fonts\ProfileFontCatalog.cs" Link="Linked\Services\Fonts\ProfileFontCatalog.cs" />
    <!-- The editor sessions (history, dirty state, Basic mode) reach the game and the renderer only
         through the narrow interfaces in UI/Editor/EditorServices.cs, so they build here too. -->
    <Compile Include="..\AetherFrame\UI\Editor\*.cs" Link="Linked\UI\Editor\%(Filename)%(Extension)" />
    <Compile Include="..\AetherFrame\UI\Library\*.cs" Link="Linked\UI\Library\%(Filename)%(Extension)" />
    <!-- The design tokens (colors, measurements) and the tutorial's progression, geometry and
         preferences are plain logic: the ImGui side of both lives under Windows/ and stays out. -->
    <Compile Include="..\AetherFrame\UI\Theme\*.cs" Link="Linked\UI\Theme\%(Filename)%(Extension)" />
    <Compile Include="..\AetherFrame\UI\Tutorial\*.cs" Link="Linked\UI\Tutorial\%(Filename)%(Extension)" />
    <Compile Include="..\AetherFrame\UI\Rendering\ProfileRenderOptions.cs" Link="Linked\UI\Rendering\ProfileRenderOptions.cs" />
    <Compile Include="..\AetherFrame\UI\Rendering\ProfilePaintOrder.cs" Link="Linked\UI\Rendering\ProfilePaintOrder.cs" />
    <Compile Include="..\AetherFrame\UI\Rendering\CanvasHitTest.cs" Link="Linked\UI\Rendering\CanvasHitTest.cs" />
    <Compile Include="..\AetherFrame\UI\Rendering\ProfileVisualBounds.cs" Link="Linked\UI\Rendering\ProfileVisualBounds.cs" />
    <Compile Include="..\AetherFrame\UI\Rendering\PlateViewerLayout.cs" Link="Linked\UI\Rendering\PlateViewerLayout.cs" />
    <Compile Include="..\AetherFrame\UI\Rendering\PlateViewerTarget.cs" Link="Linked\UI\Rendering\PlateViewerTarget.cs" />
    <Compile Include="..\AetherFrame\UI\Rendering\PlateCardPreview.cs" Link="Linked\UI\Rendering\PlateCardPreview.cs" />
    <Compile Include="..\AetherFrame\UI\Rendering\ImageFitLayout.cs" Link="Linked\UI\Rendering\ImageFitLayout.cs" />
    <!-- NETWORK2's snapshot builder (N2-6a) is part of the sharing build, the default build since
         October 1, 2026 (releases carry sharing from 0.1.8). It is free of Dalamud and ImGui, so it
         is tested here, against the real Plate model and the protocol library's own codec
         (referenced below). The player flavour (-p:AetherFrameNetworkPreview=false, built once in
         CI) leaves it out: its boundary tests keep proving that it holds no protocol type. -->
    <Compile Include="..\AetherFrame\Services\Network\Publishing\**\*.cs" Link="Linked\Services\Network\Publishing\%(RecursiveDir)%(Filename)%(Extension)" />
    <!-- The publication index and outbox (N2-6c) write their files as the persona registry does,
         with the persona folder's written-through move, and sign through the persona library
         (referenced below), so the commit is tested with real signatures from throwaway keys. -->
    <Compile Include="..\AetherFrame\Services\Network\Personas\WrittenThroughMove.cs" Link="Linked\Services\Network\Personas\WrittenThroughMove.cs" />
    <!-- Opting characters in and out of sharing (N2-9b), with the client it sends through (N2-9a).
         Both are free of Dalamud and ImGui; the tests answer as the server would, in memory. -->
    <Compile Include="..\AetherFrame\Services\Network\Sharing\**\*.cs" Link="Linked\Services\Network\Sharing\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\AetherFrame\Services\Network\Transport\SharingClient.cs" Link="Linked\Services\Network\Transport\SharingClient.cs" />
    <Compile Include="..\AetherFrame\Services\Network\Transport\SharingDeployment.cs" Link="Linked\Services\Network\Transport\SharingDeployment.cs" />
    <!-- The Lodestone pipe (checking a character through the player's own connection), driven
         against a WebSocket answered in memory and a stand-in for its connection to the Lodestone,
         so nothing the tests run reaches the Lodestone. -->
    <Compile Include="..\AetherFrame\Services\Network\Transport\LodestonePipe.cs" Link="Linked\Services\Network\Transport\LodestonePipe.cs" />
    <!-- Art on demand's download client and its host rules, tested against an answering handler. -->
    <Compile Include="..\AetherFrame\Services\Network\Transport\ArtHosting.cs" Link="Linked\Services\Network\Transport\ArtHosting.cs" />
    <Compile Include="..\AetherFrame\Services\Network\Transport\ArtDownloadClient.cs" Link="Linked\Services\Network\Transport\ArtDownloadClient.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AetherFrame.Protocol\AetherFrame.Protocol.csproj" />
    <ProjectReference Include="..\AetherFrame.Personas\AetherFrame.Personas.csproj" />
  </ItemGroup>

  <!-- Files written by the tagged releases' own persistence code (Fixtures/v0.1.x) and the
       hand-written pre-release shapes (Fixtures/legacy), copied next to the test binaries byte for
       byte so HistoricalFixtureTests and FixtureCompatibilityTests read exactly what those builds
       wrote. Regenerated only on a deliberate schema change, never automatically. -->
  <ItemGroup>
    <None Update="Fixtures\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- What real encoders wrote (Windows' WIC, for image preparation's inventory), copied next to
       the test binaries byte for byte. Kept apart from Fixtures, which holds only historical
       documents. -->
  <ItemGroup>
    <None Update="ImageFixtures\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- A draft of unsaved changes as version 1 of its envelope writes it, copied next to the test
       binaries byte for byte, so KeptChangesReadTests reads exactly that format for as long as it
       must load. Kept apart from Fixtures, whose guards cover released builds' installations. -->
  <ItemGroup>
    <None Update="DraftFixtures\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Every PNG under the plugin's Assets folder, under the manifest resource names BuiltInArtCatalog
       uses: the previews and Celestial Dream the plugin embeds, and the hosted art players download
       (art on demand), so the art tests read each file from this assembly. -->
  <ItemGroup>
    <EmbeddedResource Include="..\AetherFrame\Assets\**\*.png">
      <LogicalName>AetherFrame.Assets.$([System.String]::Copy('%(RecursiveDir)').Replace('\', '.').Replace('/', '.'))%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

</Project>
